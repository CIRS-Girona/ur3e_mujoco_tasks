<mujoco model="peg-in-hole">
  <option viscosity="0.1" gravity="0.0 0.0 0.0" timestep="0.002"/>
  <option>
    <flag  multiccd="disable" warmstart="enable"/>
  </option>
  <visual>
    <!-- <global fovy="60" azimuth="45" elevation="-100"/> -->
    <quality shadowsize="8192" />
  </visual>
  <compiler angle="radian"/>
  <default>
    <default class="visual">
      <geom group="3" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="2" type="mesh" solimp="0.9 0.95 0.001 0.5 2" solref="0.02 1" condim="6" />
    </default>
  </default>
  <asset>
    <texture name="chequered" type="2d" builtin="checker" width="300" height="300" 
             rgb1="0.2 0.3 0.4" rgb2="0.3 0.4 0.5"/>

    <!-- Material using the checker texture and grid-like repeat -->
    <material name="grid" texture="chequered" texrepeat="5 5" reflectance="0.2"/>

    <!-- Simple material representing wood with brown color -->
    <material name="Wood" rgba="0.6 0.4 0.2 1.0"/>

    <material name="None" specular="0.8000000000000002" shininess="0.5" rgba="0.8 0.8 0.8 1"/>
    <mesh name="hole0" file="hole/hole_27/hole_27_collision_0.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole1" file="hole/hole_27/hole_27_collision_1.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole2" file="hole/hole_27/hole_27_collision_2.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole3" file="hole/hole_27/hole_27_collision_3.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole4" file="hole/hole_27/hole_27_collision_4.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole5" file="hole/hole_27/hole_27_collision_5.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole6" file="hole/hole_27/hole_27_collision_6.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole7" file="hole/hole_27/hole_27_collision_7.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole8" file="hole/hole_27/hole_27_collision_8.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole9" file="hole/hole_27/hole_27_collision_9.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole10" file="hole/hole_27/hole_27_collision_10.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole11" file="hole/hole_27/hole_27_collision_11.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole12" file="hole/hole_27/hole_27_collision_12.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole13" file="hole/hole_27/hole_27_collision_13.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole14" file="hole/hole_27/hole_27_collision_14.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole15" file="hole/hole_27/hole_27_collision_15.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole16" file="hole/hole_27/hole_27_collision_16.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole17" file="hole/hole_27/hole_27_collision_17.obj" scale="0.001 0.001 0.001"/>
    <mesh name="hole_visual" file="hole/hole_27/hole_27.obj" scale="0.001 0.001 0.001"/>
  </asset>

  <statistic center='0 0 0'/>
  <worldbody>
    <body name="floor" pos="0 0 0">
      <geom type="plane" size="2 2 0.1" material="grid"/>
    </body>

    <body name="table" pos="0 0 0">
        <!-- Tabletop as a box geometry with Wood material -->
        <geom name="table_top" type="box" size="1.2 1.2 0.05" pos="0 0 1" material="Wood"/>
        <geom type="cylinder" size="0.05 0.5" pos="-1.0 -1.0 0.5" material="Wood"/>
        <geom type="cylinder" size="0.05 0.5" pos="1.0 -1.0 0.5" material="Wood"/>
        <geom type="cylinder" size="0.05 0.5" pos="-1.0 1.0 0.5" material="Wood"/>
        <geom type="cylinder" size="0.05 0.5" pos="1.0 1.0 0.5" material="Wood"/>       
    </body>

    <!-- workspace defined with two cylinder: outer - inner -->
    <body name="outer_workspace" pos="0.0 0.0 1.075" euler="0  0.0  0">
        <geom name="outer_workspace"  type="cylinder" size="0.4 0.001" rgba="0 1 0 0.15" conaffinity="0" contype="0" group="4"/>
    </body>
    <body name="inner_workspace" pos="0.0 0.0 1.0" euler="0  0.0  0">
        <geom name="inner_workspace" type="cylinder" size="0.27 0.001" rgba="1 0 0 0.15" conaffinity="0" contype="0" group="4"/>
    </body>

    <body name="hole" euler="1.5707 0 0" pos="0.17 0.23 1.03" mocap="true">
      <geom material="None" mesh="hole_visual" class="visual" mass="0.05"/>
      <geom mesh="hole0" class="collision"/>
      <geom mesh="hole1" class="collision"/>
      <geom mesh="hole2" class="collision"/>
      <geom mesh="hole3" class="collision"/>
      <geom mesh="hole4" class="collision"/>
      <geom mesh="hole5" class="collision"/>
      <geom mesh="hole6" class="collision"/>
      <geom mesh="hole7" class="collision"/>
      <geom mesh="hole8" class="collision"/>
      <geom mesh="hole9" class="collision"/>
      <geom mesh="hole10" class="collision"/>
      <geom mesh="hole11" class="collision"/>
      <geom mesh="hole12" class="collision"/>
      <geom mesh="hole13" class="collision"/>
      <geom mesh="hole14" class="collision"/>
      <geom mesh="hole15" class="collision"/>
      <geom mesh="hole16" class="collision"/>
      <geom mesh="hole17" class="collision"/>
      <body name="hole_frame" euler="-1.5707 0 0" pos="0 0.03 0"/>
      <!-- <geom mesh="hole0" class="collision"/> -->
    </body>

    <body name="camera_center" euler="0  0.0  0" pos="0.3 0.0 1.1">
        </body>


    <body name="fixed_camera_body" euler="0  0.0  0" pos="0.65 0.1 2.3">
      <camera name="fixed_camera"  mode="targetbody" target="camera_center" fovy="42.5" />
    </body>
		  
    
 
  </worldbody>
</mujoco>

