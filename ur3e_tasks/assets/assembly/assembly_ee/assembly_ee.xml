<mujoco model="assembly_ee">
  <compiler angle="radian" />
  <!-- <option timestep="0.001"/> -->

  <asset>
    <texture type="2d" name="peg_ee" builtin="flat" rgb1="0.2 0.2 0.8" width="300" height="300"/>
    <texture type="2d" name="peg_ee_base" builtin="flat" rgb1="0.8 0.8 0.8" width="300" height="300"/>

    <material name="peg_ee" texture="peg_ee"/>  
    <material name="peg_ee_base" texture="peg_ee_base"/>    
  </asset>

  <worldbody>
    <!-- Base: positioned so that its bottom touches z=0 -->
    <body name="base" pos="0 0 0">
      <geom name="base_geom" type="cylinder" size="0.0315 0.01" material="peg_ee_base"/>
      
      <!-- Cylinder: attached on top of the base -->
      <!-- The cylinder body is positioned so that its center is 0.03 m above the base's center,
           meaning its bottom (center - 0.02 m) aligns with the top of the base at z=0.02 -->
      <body name="cylinder" pos="0 0 0.03">
        <geom name="cylinder_geom" type="cylinder" size="0.0125 0.02" material="peg_ee"/>
        
        <!-- Tip: attached on top of the cylinder -->
        <!-- Positioned so that its center is 0.03 m above the cylinder's center (0.02 m to reach the top of the cylinder plus 0.01 m half-depth of the tip) -->
        <body name="tip" pos="0 0 0.025" euler = "0 0 1.5704">
          <!-- Tip geom: box with half-sizes (0.02, 0.0125, 0.01) corresponding to (40mm, 25mm, 20mm) overall -->
          <geom name="tip_geom" type="box" size="0.0315 0.0125 0.005" material="peg_ee"/>
          <site name="tip_site" pos="0 0 0.0" euler="3.14159 0 0" group="5"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
