<mujoco model="assembly_scene">
  <compiler angle="radian" />
  <option timestep="0.002"/>
  <include file="assembly_hole/assembly_hole.xml"/>
  <!-- <include file="assembly_peg/assembly_peg.xml"/> -->
  <visual>
    <!-- <global fovy="60" azimuth="45" elevation="-100"/> -->
    <quality shadowsize="8192" />
  </visual>
  <default>
    <default class="visual">
      <geom group="3" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="2" type="mesh" solimp="0.9 0.95 0.001 0.5 2" solref="0.02 1" condim="6" />
    </default>
  </default>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <!-- <texture type="cube" name="random" file="/home/tanakrit-ubuntu/dtd-r1.0.1/dtd/images/chequered/chequered_0017.png"/> -->
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="grid" texture="chequered" texrepeat="5 5" reflectance="0.2"/>
    <!-- <material name="random" texture="random"/> -->
    <material name="Wood" rgba="0.1 0.9 0.1 1.0"/> 
    <!-- 0.6 0.4 0.2 1.0 -->
    <texture name="chequered" type="2d" builtin="checker" width="300" height="300" 
             rgb1="0.2 0.3 0.4" rgb2="0.3 0.4 0.5"/>
  </asset>
  <statistic center='0 0 0' meansize='0.15'/>

  <worldbody>

    <body name="floor" pos="0 0 0">
      
      <geom type="plane" size="2 2 0.1" material="grid"/>
    </body>
    
    <body name="table" pos="0 0 0">
        <!-- Tabletop as a box geometry with Wood material -->
        <geom name="table_top" type="box" size="1.2 1.2 0.05" pos="0 0 0.95" material="Wood"/>
        <geom type="cylinder" size="0.05 0.5" pos="-1.0 -1.0 0.5" material="Wood"/>
        <geom type="cylinder" size="0.05 0.5" pos="1.0 -1.0 0.5" material="Wood"/>
        <geom type="cylinder" size="0.05 0.5" pos="-1.0 1.0 0.5" material="Wood"/>
        <geom type="cylinder" size="0.05 0.5" pos="1.0 1.0 0.5" material="Wood"/>       
    </body>

    <body name="wall" pos="0 0 0">
        <!-- Tabletop as a box geometry with Wood material -->
        <geom name="wall_left" type="box" size="5 0.02 4" pos="0 -3 2" material="groundplane"/>
        <geom name="wall_back" type="box" size="0.02 5 4" pos="-3 0 2" material="groundplane"/>
        <geom name="wall_right" type="box" size="5 0.02 4" pos="0 3 2" material="groundplane"/>
        <geom name="wall_front" type="box" size="0.02 5 4" pos="3 0 2" material="groundplane"/>
    </body>
    
    <!-- workspace defined with two cylinder: outer - inner -->
    <body name="outer_workspace" pos="0.0 0.0 1.075" euler="0  0.0  0">
        <geom name="outer_workspace"  type="cylinder" size="0.53 0.001" rgba="0 1 0 0.15" conaffinity="0" contype="0" group="4"/>
    </body>
    <body name="inner_workspace" pos="0.0 0.0 1.0" euler="0  0.0  0">
        <geom name="inner_workspace" type="cylinder" size="0.27 0.001" rgba="1 0 0 0.15" conaffinity="0" contype="0" group="4"/>
    </body>
    
    <body name="workspace_center" euler="0  0.0  0" pos="0.0 0.0 1.0"></body>
    <body name="camera_center1" euler="0  0.0  0" pos="0.4 0.0 1.0"></body>
    <body name="camera_center2" euler="0  0.0  0" pos="0.5 0.0 1.0"></body>

    <body name="fixed_camera1" euler="0  0  0" pos="1.0 0.0 1.8">
      <camera name="fixed_camera1"  mode="targetbody" target="camera_center1" fovy="42.5" />
    </body>

    <body name="fixed_camera2" euler="0  0  0" pos="0.5 1.0 1.5">
      <camera name="fixed_camera2"  mode="targetbody" target="camera_center2" fovy="42.5" />
    </body>

    <light name="light_source" pos="1 1 2" mode="targetbody" target="workspace_center"/>
  </worldbody>
</mujoco>
