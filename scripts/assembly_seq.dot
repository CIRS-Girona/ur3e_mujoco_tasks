digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
assembly_seq [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ assembly_seq", shape=box, style=filled];
set_up [fillcolor=gray, fontcolor=black, fontsize=9, label=set_up, shape=ellipse, style=filled];
assembly_seq -> set_up;
move_to_hole [fillcolor=gray, fontcolor=black, fontsize=9, label=move_to_hole, shape=ellipse, style=filled];
assembly_seq -> move_to_hole;
assemble [fillcolor=gray, fontcolor=black, fontsize=9, label=assemble, shape=ellipse, style=filled];
assembly_seq -> assemble;
rotate [fillcolor=gray, fontcolor=black, fontsize=9, label=rotate, shape=ellipse, style=filled];
assembly_seq -> rotate;
}
